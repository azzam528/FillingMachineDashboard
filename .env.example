# Environment Mode (development / production / test)
ENVIRONMENT=development

# MongoDB Connection
# PENTING: Jangan pernah hardcode kredensial atau mencetak connection string ke log!
# Contoh lokal: mongodb://localhost:27017
# Contoh Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=liquidfilling

# Autentikasi API Key tunggal (Header X-Api-Key)
API_KEY=rahasia-api-key

# Pengaturan Keamanan Endpoint Baca
# Set true jika endpoint GET memerlukan header X-Api-Key, false jika terbuka untuk publik
REQUIRE_KEY_FOR_READ=false

# Daftar pengguna yang sah (dipisahkan koma)
PENGGUNA_VALID=gibral,haikal,alvin,naya

# Konstanta Event E-Stop untuk Perhitungan Durasi Darurat
EVENT_JENIS_ESTOP_TEKAN=estop_tekan
EVENT_JENIS_ESTOP_LEPAS=estop_lepas

# Konfigurasi Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Konfigurasi Routing & Base URL API
API_PREFIX=/api
API_V1_STR=/api
# API_BASE_URL=https://api.fillingmachine.domainkamu.com

# Konfigurasi CORS (Cross-Origin Resource Sharing) untuk Frontend MES
# Pada development: izinkan domain/port frontend lokal (Vite: 5173, Next/React: 3000, dll.)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
# Pada production: Tentukan domain frontend MES sebenarnya dan JANGAN gunakan wildcard '*'
# CORS_ORIGINS=https://mes.fillingmachine.domainkamu.com,https://fillingmachine.domainkamu.com
