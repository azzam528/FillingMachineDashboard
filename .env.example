# MongoDB Connection
# PENTING: Jangan pernah hardcode kredensial atau mencetak connection string ke log!
MONGODB_URI=
MONGODB_DB_NAME=

# Autentikasi API Key per mesin
# Format: mesin_id:api_key dipisahkan oleh tanda koma
MESIN_API_KEYS=mesin-01:kunci-rahasia-mesin-01,mesin-02:kunci-rahasia-mesin-02

# Pengaturan Keamanan Endpoint Baca
# Set true jika endpoint GET memerlukan header X-Api-Key
REQUIRE_KEY_FOR_READ=false

# Konstanta Event E-Stop untuk Perhitungan Durasi Darurat
# TODO: Nilai default sesuai konfirmasi: estop_tekan & estop_lepas
EVENT_JENIS_ESTOP_TEKAN=estop_tekan
EVENT_JENIS_ESTOP_LEPAS=estop_lepas

# Konfigurasi Server
HOST=0.0.0.0
PORT=8000
DEBUG=false
